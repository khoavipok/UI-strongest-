    Ruby = Color3.fromRGB(255, 70, 120),
    RubyRed = Color3.fromRGB(220, 40, 90),
    Purple = Color3.fromRGB(170, 90, 255),
    Ocean = Color3.fromRGB(0, 160, 220),
    Dark = Color3.fromRGB(25, 25, 25),
    DarkGray = Color3.fromRGB(45, 45, 45),
    MediumGray = Color3.fromRGB(60, 60, 60),
    LightGray = Color3.fromRGB(230, 230, 230),
    White = Color3.fromRGB(240, 240, 240)
}

--================ SIDE TAB SYSTEM =================--
local SideTabSystem = {
    -- ✅ ĐÃ THU NHỎ SIDE TAB CHO GỌN GÀNG
    Config = {
        SideWidth = 130,          -- Giảm từ 160
        SideHeight = 220,         -- Giảm từ 260
        BarWidth = 12,            -- Giảm từ 14
        Gap = 6,                  -- Giảm từ 8
        AnimTime = 0.25
    },
    State = {
        LeftOpen = true,
        RightOpen = true,
        Animating = false
    }
}

-- Tạo side tab hệ thống
local function CreateSideTabSystem(screenGui, mainFrame)
    local config = SideTabSystem.Config
    local state = SideTabSystem.State
    
    -- Left Tab
    local LeftTab = Instance.new("Frame", screenGui)
    LeftTab.Size = UDim2.new(0, config.SideWidth, 0, config.SideHeight)
    LeftTab.BackgroundColor3 = Theme.DarkGray
    LeftTab.BackgroundTransparency = 0.3
    LeftTab.Visible = false
    LeftTab.Active = true
    LeftTab.Draggable = false
    Round(LeftTab, 8)
    
    local leftStroke = Instance.new("UIStroke", LeftTab)
    leftStroke.Thickness = 2
    leftStroke.Color = Theme.Purple
    leftStroke.Transparency = 0.5
    
    -- Right Tab
    local RightTab = Instance.new("Frame", screenGui)
    RightTab.Size = UDim2.new(0, config.SideWidth, 0, config.SideHeight)
    RightTab.BackgroundColor3 = Theme.DarkGray
    RightTab.BackgroundTransparency = 0.3
    RightTab.Visible = false
    RightTab.Active = true
    RightTab.Draggable = false
    Round(RightTab, 8)
    
    local rightStroke = Instance.new("UIStroke", RightTab)
    rightStroke.Thickness = 2
    rightStroke.Color = Theme.Purple
    rightStroke.Transparency = 0.5
    
    -- Thanh dài mở lại
    local LeftBar = Instance.new("TextButton", screenGui)
    LeftBar.Size = UDim2.new(0, config.BarWidth, 0, 100)  -- Ngắn hơn cho gọn
    LeftBar.Text = ">"
    LeftBar.Font = Enum.Font.GothamBold
    LeftBar.TextSize = 12
    LeftBar.TextColor3 = Theme.White
    LeftBar.BackgroundColor3 = Theme.DarkGray
    LeftBar.BackgroundTransparency = 0.3
    LeftBar.Visible = false
    LeftBar.AutoButtonColor = false
    LeftBar.Active = true
    Round(LeftBar, 6)
    
    local LeftBarStroke = Instance.new("UIStroke", LeftBar)
    LeftBarStroke.Thickness = 1
    LeftBarStroke.Color = Theme.Ruby
    
    local RightBar = Instance.new("TextButton", screenGui)
    RightBar.Size = UDim2.new(0, config.BarWidth, 0, 100)  -- Ngắn hơn cho gọn
    RightBar.Text = "<"
    RightBar.Font = Enum.Font.GothamBold
    RightBar.TextSize = 12
    RightBar.TextColor3 = Theme.White
    RightBar.BackgroundColor3 = Theme.DarkGray
    RightBar.BackgroundTransparency = 0.3
    RightBar.Visible = false
    RightBar.AutoButtonColor = false
    RightBar.Active = true
    Round(RightBar, 6)
    
    local RightBarStroke = Instance.new("UIStroke", RightBar)
    RightBarStroke.Thickness = 1
    RightBarStroke.Color = Theme.Ruby
    
    -- Nút ẩn (-) cho side tab
    local function CreateHideButton(parent, isLeft)
        local btn = Instance.new("TextButton", parent)
        btn.Size = UDim2.new(0, 20, 0, 20)  -- Nhỏ hơn
        btn.Position = isLeft and UDim2.new(1, -24, 0, 6) or UDim2.new(0, 4, 0, 6)
        btn.Text = "-"
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 12
        btn.TextColor3 = Theme.White
        btn.BackgroundColor3 = Theme.MediumGray
        btn.BackgroundTransparency = 0.2
        btn.AutoButtonColor = false
        btn.Active = true
        Round(btn, 10)
        
        local btnStroke = Instance.new("UIStroke", btn)
        btnStroke.Thickness = 1
        btnStroke.Color = Theme.Ruby
        
        return btn
    end
    
    local HideLeft = CreateHideButton(LeftTab, true)
    local HideRight = CreateHideButton(RightTab, false)
    
    -- Logic ẩn/mở side tab - CHỈ THAY ĐỔI STATE
    local function ToggleSideTab(isLeft)
        if state.Animating then return end
        state.Animating = true
        
        if isLeft then
            if state.LeftOpen then
                -- Ẩn left tab với tween trượt
                local targetPos = LeftTab.Position - UDim2.new(0, config.SideWidth, 0, 0)
                TweenService:Create(LeftTab, TweenInfo.new(config.AnimTime), {
                    Position = targetPos
                }):Play()
                
                task.delay(config.AnimTime, function()
                    state.LeftOpen = false
                    state.Animating = false
                end)
            else
                -- Hiện left tab với tween trượt từ xa
                local startPos = mainFrame.Position - UDim2.new(0, config.SideWidth + config.Gap + 15, 0, 0)
                local endPos = mainFrame.Position - UDim2.new(0, config.SideWidth + config.Gap, 0, 0)
                
                LeftTab.Position = startPos
                TweenService:Create(LeftTab, TweenInfo.new(config.AnimTime), {
                    Position = endPos
                }):Play()
                
                state.LeftOpen = true
                state.Animating = false
            end
        else
            if state.RightOpen then
                -- Ẩn right tab với tween trượt
                local targetPos = RightTab.Position + UDim2.new(0, config.SideWidth, 0, 0)
                TweenService:Create(RightTab, TweenInfo.new(config.AnimTime), {
                    Position = targetPos
                }):Play()
                
                task.delay(config.AnimTime, function()
                    state.RightOpen = false
                    state.Animating = false
                end)
            else
                -- Hiện right tab với tween trượt từ xa
                local startPos = mainFrame.Position + UDim2.new(0, mainFrame.AbsoluteSize.X + config.Gap + 15, 0, 0)
                local endPos = mainFrame.Position + UDim2.new(0, mainFrame.AbsoluteSize.X + config.Gap, 0, 0)
                
                RightTab.Position = startPos
                TweenService:Create(RightTab, TweenInfo.new(config.AnimTime), {
                    Position = endPos
                }):Play()
                
                state.RightOpen = true
                state.Animating = false
            end
        end
    end
    
    -- Kết nối sự kiện cho nút ẩn và thanh bar (cả PC và Mobile)
    local function ConnectButtonEvents(btn, isLeft)
        btn.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or 
               input.UserInputType == Enum.UserInputType.Touch then
                if IsInputInFrame(btn, input) then
                    ToggleSideTab(isLeft)
                end
            end
        end)
    end
    
    ConnectButtonEvents(HideLeft, true)
    ConnectButtonEvents(HideRight, false)
    ConnectButtonEvents(LeftBar, true)
    ConnectButtonEvents(RightBar, false)
    
    -- Hiệu ứng hover cho PC
    LeftBar.MouseEnter:Connect(function()
        Tween(LeftBar, TweenInfo.new(0.2), {BackgroundTransparency = 0.1})
    end)
    
    LeftBar.MouseLeave:Connect(function()
        Tween(LeftBar, TweenInfo.new(0.2), {BackgroundTransparency = 0.3})
    end)
    
    RightBar.MouseEnter:Connect(function()
        Tween(RightBar, TweenInfo.new(0.2), {BackgroundTransparency = 0.1})
    end)
    
    RightBar.MouseLeave:Connect(function()
        Tween(RightBar, TweenInfo.new(0.2), {BackgroundTransparency = 0.3})
    end)
    
    -- RenderStepped: Dính chặt UI chính - QUYỀN DUY NHẤT SET VISIBLE
    RunService.RenderStepped:Connect(function()
        if not mainFrame.Visible then
            LeftTab.Visible = false
            RightTab.Visible = false
            LeftBar.Visible = false
            RightBar.Visible = false
            return
        end
        
        -- Không cập nhật khi đang animating
        if state.Animating then return end
        
        -- Cập nhật vị trí dựa trên UI chính
        local mainPos = mainFrame.Position
        local mainSize = mainFrame.AbsoluteSize
        
        -- RenderStepped quản lý duy nhất visible
        if state.LeftOpen then
            LeftTab.Position = mainPos - UDim2.new(0, config.SideWidth + config.Gap, 0, 0)
            LeftTab.Visible = true
            LeftBar.Visible = false
        else
            LeftBar.Position = mainPos - UDim2.new(0, config.BarWidth, 0, 0)
            LeftBar.Visible = true
            LeftTab.Visible = false
        end
        
        if state.RightOpen then
            RightTab.Position = mainPos + UDim2.new(0, mainSize.X + config.Gap, 0, 0)
            RightTab.Visible = true
            RightBar.Visible = false
        else
            RightBar.Position = mainPos + UDim2.new(0, mainSize.X, 0, 0)
            RightBar.Visible = true
            RightTab.Visible = false
        end
    end)
    
    return {
        LeftTab = LeftTab,
        RightTab = RightTab,
        LeftBar = LeftBar,
        RightBar = RightBar
    }
end

--================ WINDOW =================--
function Library:CreateWindow(config)
    config = config or {}
    local title = config.Title or "Khanhly Hub"
    
    -- Tạo ScreenGui
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "KhanhlyUI"
    ScreenGui.ResetOnSpawn = false
    ScreenGui.Parent = game:GetService("CoreGui")
    
    -- ✅ ĐÃ THU NHỎ UI CHÍNH CHO GỌN GÀNG
    local MainFrame = Instance.new("Frame", ScreenGui)
    MainFrame.Size = UDim2.new(0, 240, 0, 320)  -- Size chuẩn như UI cũ
    MainFrame.Position = UDim2.new(0.5, -120, 0.5, -160)  -- Giữa màn hình
    MainFrame.BackgroundColor3 = Theme.Dark
    MainFrame.BackgroundTransparency = 0.15
    MainFrame.Active = true
    MainFrame.Draggable = true
    MainFrame.Visible = false  -- Ẩn ban đầu, mở bằng Open Button
    Round(MainFrame, 8)
    
    -- Viền sóng cho Main Frame
    local mainStroke = Instance.new("UIStroke", MainFrame)
    mainStroke.Thickness = 2
    mainStroke.Color = Theme.Ruby
    
    local mainGradient = Instance.new("UIGradient", mainStroke)
    mainGradient.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Theme.Ruby),
        ColorSequenceKeypoint.new(0.5, Theme.Purple),
        ColorSequenceKeypoint.new(1, Theme.Ocean)
    }
    mainGradient.Rotation = 0
    
    -- Animation xoay viền
    task.spawn(function()
        while mainGradient and mainGradient.Parent do
            mainGradient.Rotation = mainGradient.Rotation + 1
            task.wait(0.03)
        end
    end)
    
    -- Title
    local TitleLabel = Instance.new("TextLabel", MainFrame)
    TitleLabel.Size = UDim2.new(1, 0, 0, 30)
    TitleLabel.Position = UDim2.new(0, 0, 0, 0)
    TitleLabel.BackgroundColor3 = Theme.DarkGray
    TitleLabel.BackgroundTransparency = 0.2
    TitleLabel.Text = title
    TitleLabel.TextColor3 = Theme.Ruby
    TitleLabel.Font = Enum.Font.GothamBold
    TitleLabel.TextSize = 14
    TitleLabel.TextXAlignment = Enum.TextXAlignment.Center
    Round(TitleLabel, 8)
    
    -- Container cho các control
    local Container = Instance.new("ScrollingFrame", MainFrame)
    Container.Position = UDim2.new(0, 5, 0, 35)
    Container.Size = UDim2.new(1, -10, 1, -40)
    Container.BackgroundTransparency = 1
    Container.ScrollBarThickness = 6
    Container.ScrollBarImageColor3 = Theme.Purple
    Container.ScrollBarImageTransparency = 0.5
    Container.AutomaticCanvasSize = Enum.AutomaticSize.Y
    
    local Layout = Instance.new("UIListLayout", Container)
    Layout.Padding = UDim.new(0, 8)
    Layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    
    -- ✅ THÊM OPEN BUTTON (QUAN TRỌNG)
    local OpenBtn = Instance.new("TextButton", ScreenGui)
    OpenBtn.Size = UDim2.new(0, 44, 0, 44)
    OpenBtn.Position = UDim2.new(0, 20, 0.5, -22)
    OpenBtn.Text = "≡"  -- Icon menu
    OpenBtn.Font = Enum.Font.GothamBold
    OpenBtn.TextSize = 20
    OpenBtn.TextColor3 = Theme.White
    OpenBtn.BackgroundColor3 = Theme.DarkGray
    OpenBtn.BackgroundTransparency = 0.2
    OpenBtn.AutoButtonColor = false
    OpenBtn.Active = true
    OpenBtn.Draggable = true  -- Có thể kéo nút
    Round(OpenBtn, 22)
    
    -- Viền sóng cho Open Button
    local btnStroke = Instance.new("UIStroke", OpenBtn)
    btnStroke.Thickness = 2
    btnStroke.Color = Theme.Ruby
    
    local btnGradient = Instance.new("UIGradient", btnStroke)
    btnGradient.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Theme.Ruby),
        ColorSequenceKeypoint.new(0.5, Theme.Purple),
        ColorSequenceKeypoint.new(1, Theme.Ocean)
    }
    btnGradient.Rotation = 0
    
    -- Animation xoay viền cho Open Button
    task.spawn(function()
        while btnGradient and btnGradient.Parent do
            btnGradient.Rotation = btnGradient.Rotation + 1
            task.wait(0.03)
        end
    end)
    
    -- Hiệu ứng hover cho Open Button
    OpenBtn.MouseEnter:Connect(function()
        Tween(OpenBtn, TweenInfo.new(0.2), {BackgroundTransparency = 0.1})
    end)
    
    OpenBtn.MouseLeave:Connect(function()
        Tween(OpenBtn, TweenInfo.new(0.2), {BackgroundTransparency = 0.2})
    end)
    
    -- Logic toggle UI với hiệu ứng
    local isAnimating = false
    local uiVisible = false
    
    local function toggleUI()
        if isAnimating then return end
        isAnimating = true
        
        if uiVisible then
            -- Ẩn UI
            Tween(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, 0, 0, 0),
                Position = UDim2.new(
                    MainFrame.Position.X.Scale,
                    MainFrame.Position.X.Offset + 120,
                    MainFrame.Position.Y.Scale,
                    MainFrame.Position.Y.Offset + 160
                ),
                BackgroundTransparency = 1
            }):Play()
            
            task.delay(0.3, function()
                MainFrame.Visible = false
                uiVisible = false
                isAnimating = false
            end)
        else
            -- Hiện UI
            MainFrame.Visible = true
            MainFrame.Size = UDim2.new(0, 0, 0, 0)
            MainFrame.Position = UDim2.new(
                0.5, -120,
                0.5, -160
            )
            MainFrame.BackgroundTransparency = 1
            
            Tween(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, 240, 0, 320),
                Position = UDim2.new(0.5, -120, 0.5, -160),
                BackgroundTransparency = 0.15
            }):Play()
            
            task.delay(0.3, function()
                uiVisible = true
                isAnimating = false
            end)
        end
    end
    
    -- Xử lý click cho Open Button (cả PC và Mobile)
    OpenBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or 
           input.UserInputType == Enum.UserInputType.Touch then
            toggleUI()
        end
    end)
    
    -- Tạo Side Tab System
    local SideTabs = CreateSideTabSystem(ScreenGui, MainFrame)
    
    -- Trả về Window object
    local Window = {}
    
    -- Function để thêm button vào UI
    function Window:CreateButton(text, callback)
        local btn = Instance.new("TextButton", Container)
        btn.Size = UDim2.new(0.95, 0, 0, 35)
        btn.Text = text
        btn.Font = Enum.Font.Gotham
        btn.TextSize = 13
        btn.TextColor3 = Theme.White
        btn.BackgroundColor3 = Theme.DarkGray
        btn.AutoButtonColor = false
        btn.Active = true
        Round(btn, 6)
        
        local btnStroke = Instance.new("UIStroke", btn)
        btnStroke.Thickness = 1
        btnStroke.Color = Theme.Purple
        
        -- Hiệu ứng hover
        btn.MouseEnter:Connect(function()
            Tween(btn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.MediumGray})
            Tween(btnStroke, TweenInfo.new(0.2), {Color = Theme.Ocean})
        end)
        
        btn.MouseLeave:Connect(function()
            Tween(btn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.DarkGray})
            Tween(btnStroke, TweenInfo.new(0.2), {Color = Theme.Purple})
        end)
        
        -- Click
        btn.MouseButton1Click:Connect(callback)
    end
    
    -- Function để chỉnh sửa Open Button
    function Window:EditOpenButton(config)
        if config.Size then OpenBtn.Size = config.Size end
        if config.Position then OpenBtn.Position = config.Position end
        if config.Text then OpenBtn.Text = config.Text end
        if config.TextColor then OpenBtn.TextColor3 = config.TextColor end
        if config.BackgroundColor then OpenBtn.BackgroundColor3 = config.BackgroundColor end
        if config.StrokeColor then btnStroke.Color = config.StrokeColor end
    end
    
    -- Trả về các thành phần UI để sử dụng bên ngoài
    return {
        MainFrame = MainFrame,
        LeftTab = SideTabs.LeftTab,
        RightTab = SideTabs.RightTab,
        LeftBar = SideTabs.LeftBar,
        RightBar = SideTabs.RightBar,
        Container = Container,
        CreateButton = Window.CreateButton,
        EditOpenButton = Window.EditOpenButton
    }
end
return Library
