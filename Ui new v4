    Ruby = Color3.fromRGB(255, 70, 120),
    RubyRed = Color3.fromRGB(220, 40, 90),
    Purple = Color3.fromRGB(170, 90, 255),
    Ocean = Color3.fromRGB(0, 160, 220),
    Dark = Color3.fromRGB(25, 25, 25),
    DarkGray = Color3.fromRGB(45, 45, 45),
    MediumGray = Color3.fromRGB(60, 60, 60),
    LightGray = Color3.fromRGB(230, 230, 230),
